generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  username          String             @unique @db.VarChar(50)
  email             String             @unique @db.VarChar(255)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  avatarUrl         String?            @map("avatar_url")
  privacySetting    PrivacySetting     @default(public) @map("privacy_setting")
  pushToken         String?            @map("push_token")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  notificationPrefs String?            @map("notification_prefs")
  currentStreak     Int                @default(0) @map("current_streak")
  lastActiveDate    DateTime?          @map("last_active_date")
  level             Int                @default(1)
  longestStreak     Int                @default(0) @map("longest_streak")
  totalFocusTime    Int                @default(0) @map("total_focus_time")
  totalSessions     Int                @default(0) @map("total_sessions")
  xp                Int                @default(0)
  feedEvents        FeedEvent[]
  following         Follow[]           @relation("UserFollower")
  followers         Follow[]           @relation("UserFollowing")
  friendshipsAddr   Friendship[]       @relation("Addressee")
  friendshipsReq    Friendship[]       @relation("Requester")
  goalProgress      GoalProgress[]
  goals             Goal[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  sessions          Session[]
  socialPosts       SocialPost[]       @relation("PostAuthor")
  streaks           Streak?
  groupMemberships  StudyGroupMember[]
  createdGroups     StudyGroup[]       @relation("GroupCreator")
  taskGoals         TaskGoal[]
  tasks             Task[]
  timerState        TimerState?
  userAchievs       UserAchievement[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model TimerState {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  phase            String    @db.VarChar(20)
  phaseType        String    @db.VarChar(20)
  remainingSeconds Int       @map("remaining_seconds")
  totalSeconds     Int       @map("total_seconds")
  isRunning        Boolean   @map("is_running")
  pomodoroCount    Int       @default(0) @map("pomodoro_count")
  taskLabel        String?   @map("task_label") @db.VarChar(200)
  startedAt        DateTime? @map("started_at")
  pausedAt         DateTime? @map("paused_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("timer_states")
}

model Session {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  type                   String   @db.VarChar(20)
  durationSeconds        Int      @map("duration_seconds")
  taskLabel              String?  @map("task_label") @db.VarChar(200)
  completedAt            DateTime @map("completed_at")
  createdAt              DateTime @default(now()) @map("created_at")
  clientSessionId        String?  @unique @map("client_session_id") @db.VarChar(36)
  plannedDurationSeconds Int?     @map("planned_duration_seconds")
  taskId                 String?  @map("task_id")
  task                   Task?    @relation("TaskSessions", fields: [taskId], references: [id])
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([taskId])
  @@index([type, completedAt])
  @@map("sessions")
}

model Goal {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  type         String         @db.VarChar(10)
  targetCount  Int?           @map("target_count")
  targetHours  Int?           @map("target_hours")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  goalProgress GoalProgress[]
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model GoalProgress {
  id           String    @id @default(uuid()) @db.Uuid
  goalId       String    @map("goal_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  currentCount Int       @default(0) @map("current_count")
  periodStart  DateTime  @map("period_start")
  periodEnd    DateTime  @map("period_end")
  completedAt  DateTime? @map("completed_at")
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@index([goalId, periodStart])
  @@map("goal_progress")
}

model Streak {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastSessionDate DateTime? @map("last_session_date")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Friendship {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  addresseeId String   @map("addressee_id") @db.Uuid
  status      String   @default("pending") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")
  addressee   User     @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friendships")
}

model Achievement {
  id          String              @id @default(cuid())
  title       String              @db.VarChar(200)
  description String
  icon        String              @db.VarChar(50)
  category    AchievementCategory
  key         String              @unique @db.VarChar(100)
  threshold   Int
  xpReward    Int                 @default(0)
  unlockedBy  UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String      @map("user_id") @db.Uuid
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")
  isShared      Boolean     @default(false) @map("is_shared")
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Task {
  id               String    @id @default(cuid())
  userId           String    @map("user_id") @db.Uuid
  title            String    @db.VarChar(100)
  description      String?
  dueDate          DateTime? @map("due_date")
  tags             String[]  @default([])
  estimatedMinutes Int?      @map("estimated_minutes")
  priority         String    @default("medium") @db.VarChar(10)
  isArchived       Boolean   @default(false) @map("is_archived")
  isCompleted      Boolean   @default(false) @map("is_completed")
  completedAt      DateTime? @map("completed_at")
  sessionsOnTask   Int       @default(0) @map("sessions_on_task")
  totalTimeOnTask  Int       @default(0) @map("total_time_on_task")
  sessionDates     String[]  @default([]) @map("session_dates")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  order            Int?
  taskGoalId       String?   @map("task_goal_id")

  // Recurring task fields
  isRecurring      Boolean   @default(false) @map("is_recurring")
  recurringDays    String[]  @default([]) @map("recurring_days")
  // Valid values: 'sun' | 'mon' | 'tue' | 'wed' | 'thu' | 'fri' | 'sat'. Empty array means every day.
  lastSpawnedDate  String?   @map("last_spawned_date")
  // ISO date string 'YYYY-MM-DD' — the last date an instance was spawned (lives on the template)
  parentTaskId     String?   @map("parent_task_id")
  // If set, this task is an instance spawned from the template with this ID
  recurringStreak  Int       @default(0) @map("recurring_streak")
  // Consecutive days the recurring task was completed — lives on the TEMPLATE

  sessions         Session[] @relation("TaskSessions")
  taskGoal         TaskGoal? @relation(fields: [taskGoalId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskGoal {
  id             String    @id @default(cuid())
  userId         String    @map("user_id") @db.Uuid
  title          String    @db.VarChar(80)
  tag            String?   @db.VarChar(30)
  targetSessions Int?      @map("target_sessions")
  deadline       DateTime?
  isCompleted    Boolean   @default(false) @map("is_completed")
  completedAt    DateTime? @map("completed_at")
  isArchived     Boolean   @default(false) @map("is_archived")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([userId])
  @@map("task_goals")
}

model FeedEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(30)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("feed_events")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model StudyGroup {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(100)
  emoji     String             @db.VarChar(10)
  color     String             @default("purple") @db.VarChar(20)
  isPrivate Boolean            @default(false) @map("is_private")
  createdBy String             @map("created_by") @db.Uuid
  createdAt DateTime           @default(now()) @map("created_at")
  members   StudyGroupMember[]
  creator   User               @relation("GroupCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(uuid()) @db.Uuid
  groupId  String     @map("group_id") @db.Uuid
  userId   String     @map("user_id") @db.Uuid
  joinedAt DateTime   @default(now()) @map("joined_at")
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("study_group_members")
}

model SocialPost {
  id         String   @id @default(uuid()) @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  type       String   @db.VarChar(30)
  caption    String?
  visibility String   @default("public") @db.VarChar(20)
  groupId    String?  @map("group_id") @db.Uuid
  payload    Json     @default("{}")
  reactions  Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  author     User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
  @@index([createdAt])
  @@map("social_posts")
}

// Moderation (App Store Guideline 1.2). Standalone tables (no relation fields on
// User/SocialPost) to keep the schema impact minimal.
model PostReport {
  id         String   @id @default(cuid())
  postId     String   @map("post_id")
  reportedBy String   @map("reported_by") @db.Uuid
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@map("post_reports")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

enum PrivacySetting {
  public
  friends_only
  private
}

enum AchievementCategory {
  STREAK
  SESSIONS
  FOCUS_TIME
  LEVEL
  TASKS
}
