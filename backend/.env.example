# Ascend backend — environment template.
# Copy to backend/.env and fill in real values. Never commit the result.
#
# Parsed and validated by src/config.ts, which exits on a bad value rather than
# booting half-configured. Anything not listed here is not read by the server.

# ─── Required ───────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/ascend

# Minimum 32 characters. The literal string "change-me" is rejected at boot, so
# these cannot be left as-is by accident. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string!!
JWT_REFRESH_SECRET=change-me-to-another-random-32-char!!

# ─── Optional, with defaults ────────────────────────────────────────────────

PORT=3001
DEFAULT_FOCUS_MINUTES=25
DEFAULT_SHORT_BREAK_MINUTES=5
DEFAULT_LONG_BREAK_MINUTES=15

# Deep-link scheme the Google OAuth callback bounces back into. Must match
# `scheme` in mobile/app.json (currently "ascend"). Defaults to "ascend".
APP_DEEP_LINK_SCHEME=ascend

# ─── Google Calendar sync (optional) ────────────────────────────────────────
# Leave unset to run without it: the server boots normally, the calendar works
# on local data only, and /calendar/google/auth-url returns 503.
#
# Set up at console.cloud.google.com — enable the Calendar API, configure the
# OAuth consent screen, and create a Web application OAuth client. The redirect
# URI below must be registered there EXACTLY as written.
#
# Apple Calendar needs NO server configuration — it is device-native by design,
# and its tokens and events are never stored server-side.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-backend-host/calendar/google/callback

# ─── Encryption at rest (optional) ──────────────────────────────────────────
# Encrypts third-party OAuth tokens (currently the Google Calendar access and
# refresh tokens in external_calendar_connections). Unset, the server boots
# normally and those tokens are stored as they always were, so adding this
# cannot break a deploy.
#
# Generate with: openssl rand -hex 32   (64 hex characters, validated at boot)
#
# Setting it later is safe and needs no migration: open() passes plaintext
# through untouched, so existing rows keep working and each connection is
# rewritten encrypted the next time its access token refreshes. Losing the key
# after rows are sealed means those users must reconnect Google.
# TOKEN_ENCRYPTION_KEY=

# ─── Transactional email (optional) ─────────────────────────────────────────
# Powers password reset and content-report alerts. Unset, sending is a logged
# no-op and the server boots normally, so a deploy without these cannot 500 the
# password-reset route — it just does not deliver. index.ts warns loudly at boot
# when they are missing. See src/lib/email.ts.
#
# Brevo's HTTPS API, NOT SMTP: Railway disables outbound SMTP below the Pro
# plan, so an SMTP send there does not fail fast — it hangs until the client
# times out, which reads like a wrong host or port and is neither.
#
# No domain is required. Brevo verifies a single sender address: verify one you
# already own and send from it. Dashboard → Senders & Domains to verify, then
# SMTP & API → API Keys to create a key.
#
# EMAIL_FROM is parsed for display name and address, so keep the "Name <addr>"
# form. A bare address works too.
# BREVO_API_KEY=xkeysib-your-key-here
# EMAIL_FROM=Ascend <the-address-you-verified@example.com>

# Where content-report alerts go. Falls back to EMAIL_FROM, which is already a
# verified address the operator owns, so the common case needs nothing here.
# MODERATION_ALERT_TO=

# Marketing demo account (npm run seed:demo-account) — staging only. See README.
# DEMO_ACCOUNT_EMAIL=test@ascend.com
# DEMO_ACCOUNT_PASSWORD=
# DEMO_TIMEZONE=America/Chicago
# DEMO_SEED_HOST=
