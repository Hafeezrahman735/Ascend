
PORT=3001

# Single PostgreSQL database for all data
DATABASE_URL=postgresql://pomodoro:pomodoro@localhost:5432/pomodoro

# JWT secrets (min 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string!!
JWT_REFRESH_SECRET=change-me-to-another-random-32-char!!

# Timer defaults (optional)
DEFAULT_FOCUS_MINUTES=25
DEFAULT_SHORT_BREAK_MINUTES=5
DEFAULT_LONG_BREAK_MINUTES=15

# Expo push notifications (optional until configured)

# Encrypts third-party OAuth tokens at rest (currently Google Calendar access
# and refresh tokens in external_calendar_connections). OPTIONAL: unset, the
# server boots normally and those tokens are stored as they always were, so
# adding this cannot break a deploy.
#
# Generate with:  openssl rand -hex 32
#
# Setting it later is safe and needs no migration. `open()` passes plaintext
# through untouched, so existing rows keep working, and each connection is
# re-written encrypted the next time its access token is refreshed.
# Losing the key after rows are sealed means those users must reconnect Google.
# TOKEN_ENCRYPTION_KEY=
