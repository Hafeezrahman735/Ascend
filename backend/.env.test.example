# Integration test environment. Copy to .env.test and set your local password.
#
# These tests TRUNCATE every table between tests, so DATABASE_URL must point at
# a throwaway LOCAL database. src/test/env.ts refuses to run against any host
# other than localhost — do not point this at Railway.
#
# One-time setup:
#   createdb -U postgres ascend_test
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/ascend_test"

NODE_ENV=test

# Throwaway secrets — only ever used against the local test database.
# They must be at least 32 characters to satisfy src/config.ts.
JWT_ACCESS_SECRET=test-access-secret-not-used-anywhere-real-0123456789
JWT_REFRESH_SECRET=test-refresh-secret-not-used-anywhere-real-0123456789
