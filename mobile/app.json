{
  "expo": {
    "name": "Ascend",
    "slug": "ascend",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ascend",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#08081A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hafeezrahman.ascend",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08081A"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.hafeezrahman.ascend",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00E5C3",
          "sounds": [
            "./assets/sounds/timer_complete.wav"
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-calendar",
        {
          "calendarPermission": "Ascend shows the events already on your calendar beside your tasks, so you can plan focus sessions around them. Events are read on your device and never leave it.",
          "remindersPermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.hafeezrahman.ascend.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.hafeezrahman.ascend"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e891b005-10df-49b0-9e5a-2eae20e42b11"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e891b005-10df-49b0-9e5a-2eae20e42b11"
    }
  }
}
