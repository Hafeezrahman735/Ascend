# Ascend mobile — environment template.
# Copy to mobile/.env and point at your backend. Never commit the result.
#
# Expo only exposes variables prefixed EXPO_PUBLIC_, and it substitutes them at
# BUILD time, not runtime — so after editing this, restart Metro with a cleared
# cache (`npm run dev:clear`) or the old values stay baked in.
#
# These are the only two the client reads (constants/Config.ts). There is no
# fallback: a missing value fails loudly at startup rather than silently
# pointing the app at the wrong environment.
#
# EXPO_PUBLIC_* values ship inside the app bundle and are readable by anyone who
# downloads it. Put URLs here — never a secret, key or token.

EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=ws://localhost:3001
