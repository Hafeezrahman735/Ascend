# Pin peer-dependency resolution for this project.
#
# This exists because of a real EAS build failure. A user-level ~/.npmrc on the
# maintainer's machine set `legacy-peer-deps=true`, which is invisible to both
# this repo and to CI. Under that flag npm skips peer resolution entirely, so
# `npm install` wrote a lock file with several NON-OPTIONAL peers missing:
#
#   react-native-worklets        -> @react-native/metro-config (*)
#   @testing-library/user-event  -> @testing-library/dom (>=7.21.4)
#
# Local `npm ci` accepted that lock (same flag), so it looked fine here. The EAS
# builder has no such config, resolved peers strictly, and failed:
#   "npm ci can only install packages when your package.json and
#    package-lock.json are in sync. Missing: @react-native/metro-config@0.86.2..."
#
# Setting it explicitly here makes local and EAS agree, and stops a future
# `npm install` on a differently-configured machine from silently rewriting the
# lock back into a shape that only builds on that machine.
legacy-peer-deps=false
