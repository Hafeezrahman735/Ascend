# Environment / secrets — never commit
.env
.env.local
.env.*.local

# Expo
.expo/
expo-env.d.ts

# Dependencies
node_modules/

# Native projects are generated by prebuild (CNG) and never committed. app.json
# is the source of truth; committing these would let them drift from the plugin
# config and would make EAS build a stale native project instead of prebuilding.
/android
/ios
