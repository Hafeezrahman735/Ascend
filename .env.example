# Ascend — Backend Environment Variables
# Copy to backend/.env and fill in real values.

PORT=3001

# Single PostgreSQL database for all data
DATABASE_URL=postgresql://pomodoro:pomodoro@localhost:5432/pomodoro

# JWT secrets (min 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string!!
JWT_REFRESH_SECRET=change-me-to-another-random-32-char!!

# Timer defaults (optional)
DEFAULT_FOCUS_MINUTES=25
DEFAULT_SHORT_BREAK_MINUTES=5
DEFAULT_LONG_BREAK_MINUTES=15

# Expo push notifications (optional until configured)

# ── Google Calendar sync (optional) ──────────────────────────────────────────
# Leave unset to run without Google Calendar: the server boots normally, the
# calendar works with local data only, and /calendar/google/auth-url returns 503.
#
# Set up at console.cloud.google.com — enable the Calendar API, configure the
# OAuth consent screen, and create a Web application OAuth client. The redirect
# URI below must be registered there EXACTLY as written.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-host/calendar/google/callback

# Deep-link scheme the OAuth callback bounces back into. Must match `scheme` in
# mobile/app.json (currently "ascend"). Defaults to "ascend" when unset.
APP_DEEP_LINK_SCHEME=ascend

# Apple Calendar needs NO server configuration — it is device-native by design,
# and its tokens/events must never be stored server-side.
